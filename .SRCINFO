pkgbase = phonograph
	pkgdesc = phonograph-audio: the live cava spectrum (what you hear, 48 bars over a local WebSocket) behind clockmost-shell's MEDIA tab
	pkgver = 0.2.0
	pkgrel = 1
	url = https://git.clockmost.com/pkgs/phonograph
	install = phonograph.install
	arch = x86_64
	license = MIT
	makedepends = rust
	makedepends = cargo
	makedepends = mold
	depends = gcc-libs
	depends = glibc
	depends = cava
	options = !lto
	options = !debug

pkgname = phonograph
